# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# OS files and private key material
.DS_Store
Thumbs.db
.idea/
.vscode/
*.pem
*.key
*.crt
*.p12
*.pfx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment files; keep only documented, placeholder-only templates
.env*
!.env.local.example
!backend/.env.example

# Vercel local project metadata
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python backend and isolated local verification database
backend/.venv/
.venv/
backend/.postgres-test/
backend/.postgres-test.log
__pycache__/
*.egg-info/
.pytest_cache/
pytest-cache-files-*/
.mypy_cache/
.ruff_cache/
*.db
*.sqlite
*.sqlite3
*.log
